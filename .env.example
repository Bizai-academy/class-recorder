# Sao chép file này thành ".env" rồi điền giá trị. Dòng nào để trống sẽ dùng mặc định.

# ── Hiển thị trong phòng học ────────────────────────────────────────────────
BOT_NAME=Bot ghi hinh buoi hoc

# ── Phiên âm (speech-to-text) ───────────────────────────────────────────────
# Cách 1 — chạy trên máy này, miễn phí (cài một lần: node scripts/setup-stt.mjs):
#   STT_PROVIDER=local        STT_LOCAL_MODEL=large-v3
# Cách 2 — qua dịch vụ API tương thích OpenAI /audio/transcriptions (STT_PROVIDER=auto):
STT_PROVIDER=auto
STT_LOCAL_MODEL=large-v3         # large-v3 (chính xác nhất) | large-v3-turbo (nhanh gấp đôi) | medium | small
STT_FALLBACK_LOCAL=true          # dịch vụ API lỗi/hết hạn mức → tự phiên âm tại máy (nếu đã cài)
STT_LOCAL_DEVICE=auto            # auto | cuda | cpu
STT_LOCAL_THREADS=0              # số luồng CPU khi chạy trên CPU, 0 = tự chọn
# OpenAI:  STT_BASE_URL=https://api.openai.com/v1        STT_MODEL=whisper-1
# Groq:    STT_BASE_URL=https://api.groq.com/openai/v1   STT_MODEL=whisper-large-v3   (có hạn mức miễn phí)
# Fish:    STT_BASE_URL=https://api.fish.audio/v1         STT_MODEL=transcribe-1-pro   (API riêng /v1/asr, tự nhận theo URL)
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=vi
# Dịch vụ dự phòng: dịch vụ chính lỗi/hết tiền giữa chừng thì phần còn lại chuyển sang đây (phần đã phiên âm được giữ).
# Để trống = không dùng. Ví dụ Groq (miễn phí, key lấy ở console.groq.com; hết hạn mức theo giờ thì bot tự chờ rồi gửi tiếp):
#   STT_BACKUP_BASE_URL=https://api.groq.com/openai/v1   STT_BACKUP_MODEL=whisper-large-v3
STT_BACKUP_BASE_URL=
STT_BACKUP_API_KEY=
STT_BACKUP_MODEL=

# ── Tóm tắt (Claude API) ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-opus-5-5
SUMMARY_EFFORT=medium
SUMMARY_LANGUAGE=tiếng Việt
SUMMARY_CONTEXT=          # ghi chú về lớp: môn học, tên riêng, thuật ngữ hay bị phiên âm sai

# ── Vòng đời buổi học (phút) ────────────────────────────────────────────────
WAIT_OPEN_MIN=90          # chờ phòng mở tối đa
REJOIN_GRACE_MIN=5        # sau khi phòng đóng, chờ lệnh rejoin / phòng mở lại (0 = kết thúc ngay)
MAX_HOURS=6               # giới hạn an toàn cho cả phiên
ALONE_MIN=10              # chỉ còn một mình trong phòng quá lâu → coi như lớp đã tan
SILENCE_END_MIN=30        # phòng im lặng tuyệt đối quá lâu → coi như lớp đã tan (0 = tắt)
RETRY_SAME_LINK=false     # sau khi phòng đóng, tự thử vào lại link cũ (vào lại mà phòng trống thì tự rời)
MEET_WAIT_FOR_OTHERS=true # Google Meet: chỉ vào khi đã có người trong phòng
ACCEPT_TERMS=true         # tự bấm "I Agree" điều khoản của Zoom web client khi vào phòng

# ── Chất lượng ghi ──────────────────────────────────────────────────────────
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=15
VIDEO_KBPS=1200           # ~0.6 GB mỗi giờ
VIDEO_CODEC=vp8           # vp8 (nhẹ CPU) | vp9 (file nhỏ hơn, nặng CPU hơn)
OUTPUT_FORMAT=webm        # webm (xuất nhanh) | mp4 (nén lại H.264, tốn CPU nhưng mở được ở mọi nơi)

# ── Trình duyệt ─────────────────────────────────────────────────────────────
HEADLESS=auto             # auto | true | false
BROWSER_PATH=             # để trống = tự tìm Chrome/Edge
